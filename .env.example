# Mapbox, for the property map on asset pages.
# A browser token is visible to visitors by design — use a PUBLIC token and
# restrict it by URL in the Mapbox account so it cannot be reused elsewhere.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
# Optional. Falls back to mapbox://styles/mapbox/standard when unset.
NEXT_PUBLIC_MAPBOX_STYLE_URL=
