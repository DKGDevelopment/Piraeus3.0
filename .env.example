# Google Maps, for the property map on asset pages.
# Colour and labelling are configured in Google Cloud against the Map ID, not in
# code. Advanced Markers also require the Map ID.
# Restrict the key by HTTP referrer in the Cloud console — a browser key is
# visible to visitors by design, and the referrer restriction is what stops it
# being reused elsewhere.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Parked: the Mapbox implementation is kept in components/map/useMapboxPropertyMap.ts
# for when an account exists. Nothing reads these today.
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
# NEXT_PUBLIC_MAPBOX_STYLE_URL=
